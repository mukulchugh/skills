{
  "description": "pr-review-quiz guardrails: block unconfirmed GitHub writes while a review is in flight, inject the cached stack/MCP profile at session start, and report when a manual walkthrough finishes.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/publish_gate.py",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inject_context.py",
            "args": [],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/watch_progress.py",
            "args": [],
            "async": true,
            "asyncRewake": true,
            "timeout": 28800
          }
        ]
      }
    ]
  }
}
